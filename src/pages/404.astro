---
import Layout from "@layouts/Layout.astro";
---

<Layout title="404 Not Found | briete.me" description="ページが見つかりませんでした">
  <main class="flex flex-1 flex-col items-start justify-center py-20">
    <h1 class="font-mono text-5xl font-semibold">404</h1>
    <p class="mt-3 text-muted">Page Not Found</p>
    <a
      href="/"
      class="mt-8 text-sm underline decoration-line underline-offset-4 hover:decoration-ink"
    >
      ← Back to home
    </a>
  </main>
</Layout>
