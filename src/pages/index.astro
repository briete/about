---
import PostList from "@components/PostList.astro";
import SiteHeader from "@components/SiteHeader.astro";
import Layout from "@layouts/Layout.astro";
import { build } from "@utils/builder";

const recentPosts = (await build()).slice(0, 5);


// Experience is stored as a start year so the years shown stay correct over time.
const currentYear = new Date().getFullYear();
const since = (years: number) => 2026 - years;

const skills: { category: string; items: { name: string; since: number }[] }[] =
  [
    {
      category: "Cloud & Infrastructure",
      items: [
        { name: "AWS", since: since(8) },
        { name: "Terraform", since: since(5) },
        { name: "Google Cloud", since: since(2) },
        { name: "Cloudflare", since: since(1) },
      ],
    },
    {
      category: "Languages & Frameworks",
      items: [
        { name: "TypeScript", since: since(10) },
        { name: "JavaScript", since: since(10) },
        { name: "Node.js", since: since(10) },
        { name: "React", since: since(5) },
        { name: "Next.js", since: since(5) },
        { name: "Kotlin", since: since(4) },
        { name: "Java", since: since(4) },
        { name: "Spring Boot", since: since(4) },
        { name: "Python", since: since(3) },
        { name: "Vue.js", since: since(3) },
        { name: "Nuxt", since: since(3) },
        { name: "Rust", since: since(1) },
        { name: "Scala", since: since(1) },
      ],
    },
  ];

const otherSkills = ["C#", "Hono"];

// Chart axis: from the earliest start year to the current year, so each
// bar's length is exactly its years of experience.
const axisStart = Math.min(
  ...skills.flatMap(group => group.items.map(item => item.since))
);
const axisSpan = currentYear - axisStart;
const axisYears = Array.from({ length: axisSpan + 1 }, (_, i) => axisStart + i);
const pos = (year: number) => `${((year - axisStart) / axisSpan) * 100}%`;

type Position = {
  period: string;
  description: string;
  techStack?: string[];
};

type WorkExperience = {
  company: string;
  period?: string;
  positions: Position[];
};

const workExperiences: WorkExperience[] = [
  {
    company: "クラスメソッド株式会社",
    period: "2019.04 — Present",
    positions: [
      {
        period: "2022.10 — Present",
        description: "自社プロダクトの設計、開発、保守を担当",
        techStack: [
          "AWS",
          "Spring Boot",
          "TypeScript",
          "Kotlin",
          "Java",
          "Rust",
          "Python",
          "Next.js",
          "React",
        ],
      },
      {
        period: "2019.04 — 2022.09",
        description:
          "MAD (Modern Application Development)事業を通じて、顧客プロダクトのモダナイズや新規開発を担当。",
        techStack: [
          "AWS",
          "TypeScript",
          "Python",
          "Node.js",
          "React",
          "Nuxt",
          "Vue.js",
          "GraphQL",
        ],
      },
    ],
  },
  {
    company: "人材系スタートアップ企業",
    period: "2024.07 — 2026.05",
    positions: [
      {
        period: "2024.07 — 2026.05",
        description: "業務委託として自社プロダクトの開発を担当していました。",
        techStack: ["Cloudflare", "Hono", "Next.js", "React", "TypeScript"],
      },
    ],
  },
  {
    company: "Contrea株式会社",
    period: "2023.06 — Present",
    positions: [
      {
        period: "2023.06 — Present",
        description: "業務委託として自社プロダクトの開発を担当しています。",
        techStack: ["Google Cloud", "Firebase", "Nuxt", "Vue.js", "TypeScript"],
      },
    ],
  },
  {
    company: "株式会社アドウイック",
    period: "2014.04 — 2019.04",
    positions: [
      {
        period: "2014.04 — 2019.04",
        description: "受託開発や自社パッケージの販売管理システムの開発を担当",
        techStack: [".NET Framework", "VB.NET", "ASP.NET", "C#"],
      },
    ],
  },
];

const certifications: {
  title: string;
  items: { name: string; period?: string }[];
}[] = [
  {
    title: "IPA情報処理技術者試験",
    items: [
      { name: "データベーススペシャリスト試験" },
      { name: "応用情報技術者試験" },
      { name: "基本情報技術者試験" },
    ],
  },
  {
    title: "Claude認定試験",
    items: [
      { name: "Claude Certified Architect – Professional" },
      { name: "Claude Certified Developer – Professional" },
      { name: "Claude Certified Developer – Foundations" },
    ],
  },
  {
    title: "AWS認定試験",
    items: [
      { name: "Japan AWS All Certifications Engineer", period: "2022-2026" },
      { name: "APN AWS Top Engineer", period: "2021" },
    ],
  },
];
---

<Layout title="briete">
  <SiteHeader asHeading />
  <main class="flex-1 pb-12">


    <section class="pb-10 pt-4">
      <h2 class="mb-6 text-sm font-semibold text-muted">Work</h2>
      <div class="space-y-10">
        {
          workExperiences.map(exp => (
            <div>
              <div class="flex flex-wrap items-baseline justify-between gap-x-4">
                <h3 class="font-semibold">{exp.company}</h3>
                {exp.period && (
                  <span class="font-mono text-xs text-muted">{exp.period}</span>
                )}
              </div>
              <ul class="mt-4 space-y-5">
                {exp.positions.map(pos => (
                  <li>
                    {pos.period !== exp.period && (
                      <p class="font-mono text-xs text-muted">{pos.period}</p>
                    )}
                    <p class="mt-1 text-sm leading-relaxed">
                      {pos.description}
                    </p>
                    {pos.techStack && (
                      <p class="mt-1.5 text-xs text-muted">
                        {pos.techStack.join(" · ")}
                      </p>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <section class="border-t border-line py-10">
      <h2 class="mb-6 text-sm font-semibold text-muted">Skills</h2>

      <!-- Year axis -->
      <div class="flex items-end gap-3 text-[10px] text-muted sm:gap-4">
        <div class="w-24 shrink-0 sm:w-28"></div>
        <div class="relative h-4 flex-1 font-mono">
          {
            axisYears
              .filter(year => year % 2 === 0)
              .map(year => (
                <span
                  class="absolute bottom-0 -translate-x-1/2"
                  style={`left: ${pos(year)}`}
                >
                  {year}
                </span>
              ))
          }
        </div>
        <div class="w-8 shrink-0"></div>
      </div>

      <div class="mt-2 space-y-6">
        {
          skills.map(group => (
            <div>
              <h3 class="mb-2 text-xs font-medium text-muted">
                {group.category}
              </h3>
              <ul class="space-y-1.5">
                {group.items.map(item => {
                  const years = currentYear - item.since;
                  return (
                    <li class="flex items-center gap-3 text-sm sm:gap-4">
                      <span class="w-24 shrink-0 truncate sm:w-28">
                        {item.name}
                      </span>
                      <div class="relative h-5 flex-1">
                        {axisYears.map(year => (
                          <span
                            class="absolute inset-y-0 w-px bg-line"
                            style={`left: ${pos(year)}`}
                          />
                        ))}
                        <span
                          class="absolute inset-y-1.5 rounded-full bg-ink"
                          style={`left: ${pos(item.since)}; right: 0`}
                          title={`${item.name}: ${item.since} – present`}
                        />
                      </div>
                      <span class="w-8 shrink-0 text-right font-mono text-xs text-muted">
                        {years}年
                      </span>
                    </li>
                  );
                })}
              </ul>
            </div>
          ))
        }
      </div>

      <p class="mt-6 text-xs text-muted">
        その他: {otherSkills.join(", ")}
      </p>
    </section>

    <section class="border-t border-line py-10">
      <h2 class="mb-6 text-sm font-semibold text-muted">Certifications</h2>
      <div class="space-y-6 text-sm">
        {
          certifications.map(group => (
            <div>
              <h3 class="mb-2 text-xs font-medium text-muted">
                {group.title}
              </h3>
              <ul class="space-y-1">
                {group.items.map(item => (
                  <li>
                    {item.name}
                    {item.period && (
                      <span class="ml-2 font-mono text-xs text-muted">
                        {item.period}
                      </span>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <section class="border-t border-line py-10">
      <h2 class="mb-6 text-sm font-semibold text-muted">Blog</h2>
      <PostList posts={recentPosts} />
      <a
        href="/blog"
        class="mt-6 inline-block text-sm underline decoration-line underline-offset-4 transition-colors hover:decoration-ink"
      >
        すべての記事を見る →
      </a>
    </section>
  </main>
</Layout>
