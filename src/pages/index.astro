---
import Layout from "@layouts/Layout.astro";

type Level = "Expert" | "Advanced" | "Intermediate";

const links = [
  { href: "https://github.com/briete", label: "GitHub" },
  { href: "https://zenn.dev/briete", label: "Zenn" },
  { href: "mailto:contact@briete.me", label: "Email" },
];

const skills: { category: string; items: { name: string; level: Level }[] }[] =
  [
    {
      category: "Cloud & Infrastructure",
      items: [
        { name: "AWS", level: "Expert" },
        { name: "Terraform", level: "Advanced" },
        { name: "Google Cloud", level: "Intermediate" },
        { name: "Cloudflare", level: "Intermediate" },
      ],
    },
    {
      category: "Languages & Frameworks",
      items: [
        { name: "TypeScript", level: "Expert" },
        { name: "JavaScript", level: "Expert" },
        { name: "Node.js", level: "Expert" },
        { name: "Kotlin", level: "Advanced" },
        { name: "Java", level: "Advanced" },
        { name: "Spring Boot", level: "Advanced" },
        { name: "Rust", level: "Intermediate" },
        { name: "Scala", level: "Intermediate" },
        { name: "Python", level: "Intermediate" },
        { name: "C#", level: "Intermediate" },
        { name: "React", level: "Intermediate" },
        { name: "Next.js", level: "Intermediate" },
        { name: "Hono", level: "Intermediate" },
        { name: "Vue.js", level: "Intermediate" },
        { name: "Nuxt", level: "Intermediate" },
      ],
    },
  ];

const levels: Level[] = ["Expert", "Advanced", "Intermediate"];

type Position = {
  title: string;
  period: string;
  description: string;
  techStack?: string[];
};

type WorkExperience = {
  company: string;
  period?: string;
  positions: Position[];
};

const workExperiences: WorkExperience[] = [
  {
    company: "クラスメソッド株式会社",
    period: "2019.04 — Present",
    positions: [
      {
        title: "クラウド事業本部 サービス開発室",
        period: "2022.10 — Present",
        description: "自社サービスの設計、開発、保守を担当",
        techStack: [
          "AWS",
          "Spring Boot",
          "TypeScript",
          "Kotlin",
          "Java",
          "Rust",
          "Python",
          "Next.js",
          "React",
        ],
      },
      {
        title: "CX事業本部 MAD事業部",
        period: "2019.04 — 2022.09",
        description:
          "MAD (Modern Application Development)事業を通じて、顧客プロダクトのモダナイズや新規開発を担当。",
        techStack: [
          "AWS",
          "TypeScript",
          "Python",
          "Node.js",
          "React",
          "Nuxt",
          "Vue.js",
          "GraphQL",
        ],
      },
    ],
  },
  {
    company: "業務委託（副業）",
    positions: [
      {
        title: "人材系スタートアップ企業",
        period: "2024.07 — Present",
        description: "人材系SaaSの開発支援",
        techStack: ["Cloudflare", "Hono", "Next.js", "React", "TypeScript"],
      },
      {
        title: "医療系スタートアップ企業",
        period: "2023.06 — Present",
        description: "医療系SaaSの開発支援",
        techStack: ["Google Cloud", "Firebase", "Nuxt", "Vue.js", "TypeScript"],
      },
    ],
  },
  {
    company: "株式会社アドウイック",
    period: "2014.04 — 2019.04",
    positions: [
      {
        title: "一般事業部 開発課",
        period: "2014.04 — 2019.04",
        description: "受託開発や自社パッケージの販売管理システムの開発を担当",
        techStack: [".NET Framework", "VB.NET", "ASP.NET", "C#"],
      },
    ],
  },
];

const certifications = {
  ipa: {
    title: "情報処理技術者試験",
    certs: [
      "データベーススペシャリスト試験",
      "応用情報技術者試験",
      "基本情報技術者試験",
    ],
  },
  aws: {
    title: "AWS認定資格",
    awards: [
      { name: "Japan AWS All Certifications Engineer", period: "2022-2025" },
      { name: "APN AWS Top Engineer", period: "2021" },
    ],
    certs: [
      "Solutions Architect - Professional",
      "DevOps Engineer - Professional",
      "Security - Specialty",
      "Advanced Networking - Specialty",
      "Data Engineer – Associate",
      "Machine Learning - Specialty",
      "Machine Learning Engineer - Associate",
      "AI - Practitioner",
    ],
  },
};
---

<Layout title="About | Naoya Sato" currentPage="about">
  <main class="flex-1 pb-12">
    <section class="py-10">
      <h1 class="text-2xl font-semibold tracking-tight">Naoya Sato</h1>
      <p class="mt-1 text-muted">Software Engineer at Classmethod, Inc.</p>
      <p class="mt-6 leading-relaxed">
        Specializing in cloud-native web application development. Experienced in
        every phase from contract development to in-house product creation.
      </p>
      <ul class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-sm">
        {
          links.map(link => (
            <li>
              <a
                href={link.href}
                target={link.href.startsWith("http") ? "_blank" : undefined}
                rel="noopener noreferrer"
                class="underline decoration-line underline-offset-4 transition-colors hover:decoration-ink"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="border-t border-line py-10">
      <h2 class="mb-6 text-sm font-semibold text-muted">Work</h2>
      <div class="space-y-10">
        {
          workExperiences.map(exp => (
            <div>
              <div class="flex flex-wrap items-baseline justify-between gap-x-4">
                <h3 class="font-semibold">{exp.company}</h3>
                {exp.period && (
                  <span class="font-mono text-xs text-muted">{exp.period}</span>
                )}
              </div>
              <ul class="mt-4 space-y-5">
                {exp.positions.map(pos => (
                  <li>
                    <div class="flex flex-wrap items-baseline justify-between gap-x-4">
                      <p class="text-sm font-medium">{pos.title}</p>
                      <span class="font-mono text-xs text-muted">
                        {pos.period}
                      </span>
                    </div>
                    <p class="mt-1 text-sm leading-relaxed text-muted">
                      {pos.description}
                    </p>
                    {pos.techStack && (
                      <p class="mt-1.5 text-xs text-muted">
                        {pos.techStack.join(" · ")}
                      </p>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <section class="border-t border-line py-10">
      <h2 class="mb-6 text-sm font-semibold text-muted">Skills</h2>
      <div class="space-y-6">
        {
          skills.map(group => (
            <div>
              <h3 class="mb-2 text-sm font-medium">{group.category}</h3>
              <dl class="space-y-1 text-sm">
                {levels.map(level => {
                  const names = group.items
                    .filter(item => item.level === level)
                    .map(item => item.name);
                  return names.length > 0 ? (
                    <div class="flex gap-4">
                      <dt class="w-24 shrink-0 text-muted">{level}</dt>
                      <dd>{names.join(", ")}</dd>
                    </div>
                  ) : null;
                })}
              </dl>
            </div>
          ))
        }
      </div>
    </section>

    <section class="border-t border-line py-10">
      <h2 class="mb-6 text-sm font-semibold text-muted">Certifications</h2>
      <div class="space-y-6 text-sm">
        <div>
          <h3 class="mb-2 font-medium">{certifications.aws.title}</h3>
          <ul class="mb-3 space-y-1">
            {
              certifications.aws.awards.map(award => (
                <li>
                  {award.name}
                  <span class="ml-2 font-mono text-xs text-muted">
                    {award.period}
                  </span>
                </li>
              ))
            }
          </ul>
          <ul class="space-y-1 text-muted">
            {
              certifications.aws.certs.map(cert => (
                <li>AWS Certified {cert}</li>
              ))
            }
          </ul>
        </div>
        <div>
          <h3 class="mb-2 font-medium">{certifications.ipa.title}</h3>
          <ul class="space-y-1 text-muted">
            {certifications.ipa.certs.map(cert => <li>{cert}</li>)}
          </ul>
        </div>
      </div>
    </section>
  </main>
</Layout>
