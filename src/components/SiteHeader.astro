---
export interface Props {
  // Render the site name as the page's h1 (top page only).
  asHeading?: boolean;
}

const { asHeading = false } = Astro.props;
const Name = asHeading ? "h1" : "p";

const links = [
  { href: "https://github.com/briete", label: "GitHub" },
  { href: "https://zenn.dev/briete", label: "Zenn" },
  { href: "https://x.com/briete_ns", label: "X" },
];
---

<header class="flex items-start justify-between py-8 text-sm">
  <div>
    <Name class="text-2xl font-semibold tracking-tight">
      <a href="/" class="hover:opacity-60">briete</a>
    </Name>
    <p class="mt-0.5 text-sm text-muted">ソフトウェアエンジニア</p>
  </div>
  <nav class="flex items-center gap-5 pt-2 text-muted">
    {
      links.map(link => (
        <a
          href={link.href}
          target="_blank"
          rel="noopener noreferrer"
          class="transition-colors hover:text-ink"
        >
          {link.label}
        </a>
      ))
    }
  </nav>
</header>
