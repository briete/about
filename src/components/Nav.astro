---
import { Moon, Sun } from "@lucide/astro";

export interface Props {
  currentPage?: "about" | "blog";
}

const { currentPage } = Astro.props;

const links = [
  { href: "/", label: "About", key: "about" },
  { href: "/blog", label: "Blog", key: "blog" },
] as const;
---

<header class="flex items-center justify-between py-8 text-sm">
  <a href="/" class="font-semibold text-ink hover:opacity-60">briete.me</a>
  <nav class="flex items-center gap-5 text-muted">
    {
      links.map(link => (
        <a
          href={link.href}
          aria-current={currentPage === link.key ? "page" : undefined}
          class={`transition-colors hover:text-ink ${currentPage === link.key ? "text-ink" : ""}`}
        >
          {link.label}
        </a>
      ))
    }
    <button
      type="button"
      id="theme-btn"
      class="-mr-1 p-1 transition-colors hover:text-ink"
      aria-label="Toggle theme"
    >
      <Sun size={16} id="sun-svg" />
      <Moon size={16} id="moon-svg" />
    </button>
  </nav>
</header>
